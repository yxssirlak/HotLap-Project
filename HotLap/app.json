{
  "expo": {
    "name": "HotLap",
    "slug": "hotlap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.yassir.hotlap",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yassir.hotlap"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "HotLap uses your photos so you can add a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HotLap uses your location while you use the app to show your position and record drives."
        }
      ]
    ],
    "extra": {
      "googleMapsConfigured": false,
      "eas": {
        "projectId": "4c5313e2-8978-4ced-ac52-851f823f9eae"
      }
    },
    "owner": "yxssir"
  }
}
